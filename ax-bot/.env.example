# --- Slack ---
# Bot User OAuth Token — from "OAuth & Permissions" (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-bot-token

# App-Level Token — from "Basic Information" with scope connections:write (starts with xapp-)
SLACK_APP_TOKEN=xapp-your-app-level-token

# --- Claude / Anthropic ---
# Anthropic API key (starts with sk-ant-)
ANTHROPIC_API_KEY=sk-ant-your-api-key

# Optional. Model id for the agent. Default: claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5

# --- Access control (optional) ---
# Comma-separated Slack user IDs allowed to use the bot. Empty = everyone.
# During private validation, set this to your own Slack user ID (e.g. U0123ABC).
ALLOWED_SLACK_USER_IDS=

# --- Database (phase-1 real data — NOT YET USED) ---
# MariaDB via MaxScale. The roadmap tool currently returns dummy data; these
# are placeholders for the real roadmap_kv query once the schema is confirmed.
DB_HOST=your-maxscale-host
DB_PORT=6446
DB_NAME=ax
DB_USER=ax
DB_PASSWORD=your-db-password
