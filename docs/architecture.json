  "cards": [
    {
      "dot": "cyan",
      "title": "Request surface",
      "items": [
        "One top-level PHP script per URL — no router, no framework",
        "index.php renders the feed; jQuery posts to save.php",
        "Bootstrap 3 and jQuery load from bower_components"
      ]
    },
    {
      "dot": "emerald",
      "title": "Shared bootstrap",
      "items": [
        "Every entry point includes common.php, so those edges need no label",
        "common.php: session_start(), config.php, one PDO handle",
        "Both sign-in paths end at $_SESSION login + user_id"
      ]
    },
    {
      "dot": "amber",
      "title": "Read from the code",
      "items": [
        "Every query interpolates $_POST / $_SESSION into SQL",
        "Passwords are unsalted SHA-1; posts are echoed unescaped",
        ".gitmodules still declares the deleted Facebook SDK path"
      ]
    }
  ]
